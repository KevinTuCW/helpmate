DATABASE_URL=postgresql://helpmate:helpmate@localhost:5432/helpmate

# --- LLM: GLM via z.ai (OpenAI-compatible) ---
LLM_PROVIDER=glm
LLM_MODEL=glm-4.7
# base URL defaults to https://api.z.ai/api/paas/v4/ (config GLM_BASE_URL)
GLM_API_KEY=your-glm-key

# --- Tool routing: a small fast model, separate from the answer model ---
# Routing is a two-way classification; glm-4.7 spends ~13s p50 on it for no gain.
# Set ROUTER_PROVIDER=llm to route with LLM_MODEL instead.
ROUTER_PROVIDER=siliconflow
ROUTER_MODEL=Qwen/Qwen3-8B

# --- Embeddings + Rerank: Qwen3 via SiliconFlow (international) ---
EMBED_PROVIDER=siliconflow
EMBED_MODEL=Qwen/Qwen3-Embedding-8B
EMBED_DIM=1024
RERANK_MODEL=Qwen/Qwen3-Reranker-8B
SILICONFLOW_API_KEY=your-siliconflow-key
# base URL defaults to https://api.siliconflow.com/v1

# --- Observability: Langfuse (US cloud) ---
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_BASE_URL=https://us.cloud.langfuse.com

TOP_K=4

# --- Identity & authorization ---
# API key -> "tenant" or "tenant:customer". The caller's tenant comes from the
# credential, never from the request body, and order lookups are filtered by the
# bound customer. Leave API_KEYS unset to run in dev mode (DEFAULT_TENANT /
# DEFAULT_CUSTOMER), which is what `clone && run` uses.
# API_KEYS={"sk-dji-alice": "dji:Alice", "sk-dji-ops": "dji"}
DEFAULT_TENANT=public
DEFAULT_CUSTOMER=Alice

# Apply the schema with the matching dim:
#   psql "$DATABASE_URL" -v dim=1024 -f db/schema.sql
# Upgrading an existing database (adds order ownership columns):
#   psql "$DATABASE_URL" -f db/migrations/002_order_ownership.sql
