DATABASE_URL=postgresql://helpmate:helpmate@localhost:5432/helpmate

# --- LLM: GLM via z.ai (OpenAI-compatible) ---
LLM_PROVIDER=glm
LLM_MODEL=glm-4.7
# base URL defaults to https://api.z.ai/api/paas/v4/ (config GLM_BASE_URL)
GLM_API_KEY=your-glm-key

# --- Embeddings + Rerank: Qwen3 via SiliconFlow (international) ---
EMBED_PROVIDER=siliconflow
EMBED_MODEL=Qwen/Qwen3-Embedding-8B
EMBED_DIM=1024
RERANK_MODEL=Qwen/Qwen3-Reranker-8B
SILICONFLOW_API_KEY=your-siliconflow-key
# base URL defaults to https://api.siliconflow.com/v1

# --- Observability: Langfuse (US cloud) ---
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_BASE_URL=https://us.cloud.langfuse.com

TOP_K=4

# Apply the schema with the matching dim:
#   psql "$DATABASE_URL" -v dim=1024 -f db/schema.sql
