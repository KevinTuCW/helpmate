DATABASE_URL=postgresql://helpmate:helpmate@localhost:5432/helpmate

# --- Provider: OpenAI (default) ---
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
EMBED_MODEL=text-embedding-3-small
EMBED_DIM=1536
OPENAI_API_KEY=sk-...

# --- Provider: GLM / 智谱 (OpenAI-compatible) ---
# LLM_PROVIDER=glm
# LLM_MODEL=glm-4-flash
# EMBED_MODEL=embedding-2
# EMBED_DIM=1024
# GLM_API_KEY=your-glm-key
# (LLM_BASE_URL is auto-set to https://open.bigmodel.cn/api/paas/v4/ for glm)

TOP_K=4

# NOTE: apply the schema with the matching dim, e.g.
#   psql "$DATABASE_URL" -v dim=1024 -f db/schema.sql
